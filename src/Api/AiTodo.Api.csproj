<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.51.0" />
    <PackageReference Include="Ical.Net" Version="5.2.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <!-- Builds the React site into wwwroot so `dotnet run` serves the whole app. Skip with -p:SkipWeb=true. -->
  <PropertyGroup>
    <WebDir>$(MSBuildProjectDirectory)/../web</WebDir>
  </PropertyGroup>
  <ItemGroup>
    <WebSource Include="$(WebDir)/src/**/*;$(WebDir)/index.html;$(WebDir)/package.json;$(WebDir)/vite.config.ts" />
  </ItemGroup>
  <Target Name="NpmInstall" BeforeTargets="BuildWeb" Condition="'$(SkipWeb)' != 'true' And !Exists('$(WebDir)/node_modules')">
    <Exec Command="npm install" WorkingDirectory="$(WebDir)" />
  </Target>
  <Target Name="BuildWeb" BeforeTargets="Build" Condition="'$(SkipWeb)' != 'true'"
          Inputs="@(WebSource)" Outputs="$(MSBuildProjectDirectory)/wwwroot/index.html">
    <Exec Command="npm run build" WorkingDirectory="$(WebDir)" />
  </Target>

</Project>
